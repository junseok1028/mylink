rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 공통 헬퍼 함수
    // ==========================================
    // 1. 로그인 여부 확인
    function isAuthenticated() {
      return request.auth != null;
    }

    // 2. 문서 소유자(본인) 여부 확인
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 1. 사용자 루트 및 프로필/링크 규칙
    // ==========================================
    match /users/{userId} {
      // 사용자 기본 정보 문서 (users/{userId})
      // - 읽기: 누구나 공개 프로필 조회 가능
      // - 쓰기: 본인 계정인 경우에만 생성, 수정, 삭제 가능
      allow read: if true;
      allow create, update, delete: if isOwner(userId);

      // (1) 링크 컬렉션 (users/{userId}/links/{linkId})
      match /links/{linkId} {
        // - 읽기: 누구나 링크 목록/상세 조회 가능
        allow read: if true;

        // - 생성 및 삭제: 소유자(본인)만 가능
        allow create, delete: if isOwner(userId);

        // - 업데이트:
        //   1) 소유자(본인)는 전체 필드 수정 가능
        //   2) clicks 또는 clickCount 필드만 변경하는 업데이트는 누구나 허용 (비로그인 방문자 포함)
        allow update: if isOwner(userId) || 
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clickCount']) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'clickCount']);
      }

      // (2) 프로필 서브컬렉션 (users/{userId}/profile/{docId})
      match /profile/{docId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      // (3) 메타데이터 서브컬렉션 (users/{userId}/metadata/{docId})
      match /metadata/{docId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    // ==========================================
    // 2. 닉네임/표시 이름 인덱스 컬렉션 (display_names)
    // ==========================================
    // 닉네임 중복 체크 및 URL/검색을 위해 사용되는 인덱스 컬렉션
    match /display_names/{name} {
      // - 읽기: 누구나 중복 확인 및 프로필 검색 가능
      allow read: if true;

      // - 생성: 로그인한 사용자가 자신의 uid를 값으로 등록할 때만 허용
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;

      // - 수정: 기존 소유자만 수정 가능하며, 소유권(uid) 변경 불가
      allow update: if isAuthenticated() 
                    && resource.data.uid == request.auth.uid 
                    && request.resource.data.uid == request.auth.uid;

      // - 삭제: 닉네임 변경 시 기존 닉네임을 소유자 본인만 해제/삭제 가능
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ==========================================
    // 기본 규칙: 명시되지 않은 경로는 모든 접근 차단
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
